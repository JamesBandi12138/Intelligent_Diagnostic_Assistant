APP_ENV=dev
APP_PORT=8000

LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

ENABLE_TAVILY_SEARCH=false
TAVILY_API_KEY=replace-with-your-tavily-key

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=ida

PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_DB=ida_memory

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_REPORTS=triage-reports
MINIO_SECURE=false

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-your-langsmith-key

