APP_ENV=dev
APP_PORT=8000

LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
ENABLE_LLM_TRIAGE=false

ENABLE_TAVILY_SEARCH=false
TAVILY_API_KEY=replace-with-your-tavily-key

REDIS_URL=redis://localhost:6380/0
REDIS_PREFIX=ida
SESSION_TTL_SECONDS=604800

MILVUS_ENABLED=false
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=ida_knowledge

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_REPORTS=triage-reports
MINIO_SECURE=false

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=replace-with-your-langsmith-key
